<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Retargeted from net9.0 to net10.0 -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Minimalist_app_icon_square_102.ico</ApplicationIcon>
    <!-- Windows manifest for file associations and DPI awareness -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Single-file self-extract publish settings -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Trimming выключен из-за динамики LLamaSharp -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Do not generate or publish symbols -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Оставляем только вариант avx2 нативных библиотек LLamaSharp для устранения конфликтов имён при single-file -->
  <PropertyGroup>
    <LlamaPreferredCpuVariant>avx2</LlamaPreferredCpuVariant>
  </PropertyGroup>
  <Target Name="PruneLlamaCpuVariants" AfterTargets="ResolvePackageAssets" BeforeTargets="ResolveReferences">
    <ItemGroup Condition="'$(LlamaPreferredCpuVariant)' == 'avx2'">
      <!-- Удаляем все кроме avx2 -->
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(RuntimeCopyLocalItems.Identity)','runtimes\\win-x64\\native\\avx\\'))" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(RuntimeCopyLocalItems.Identity)','runtimes\\win-x64\\native\\avx512\\'))" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(RuntimeCopyLocalItems.Identity)','runtimes\\win-x64\\native\\noavx\\'))" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(NativeCopyLocalItems.Identity)','runtimes\\win-x64\\native\\avx\\'))" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(NativeCopyLocalItems.Identity)','runtimes\\win-x64\\native\\avx512\\'))" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(NativeCopyLocalItems.Identity)','runtimes\\win-x64\\native\\noavx\\'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.10" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.10" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.10" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.10">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">none</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="LLamaSharp" Version="0.25.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.25.0" />
    <PackageReference Include="Microsoft.Agents.Client" Version="1.3.93-beta" />
    <PackageReference Include="Microsoft.Agents.Core" Version="1.4.9-beta" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="LiteDB" Version="6.0.0-prerelease.73" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.2-preview.1" />
    <PackageReference Include="System.ClientModel" Version="1.8.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.1" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.1" />
    <PackageReference Include="System.Memory.Data" Version="10.0.1" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.1" />
    <PackageReference Include="System.Runtime.Caching" Version="10.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.1" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.22.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Icons\MinButton.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </AvaloniaResource>
    <AvaloniaResource Include="Icons\MaxButton.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AvaloniaResource>
    <AvaloniaResource Include="Icons\CloseButton.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AvaloniaResource>
    <AvaloniaResource Include="Icons\AppIcon.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AvaloniaResource>
    <AvaloniaXaml Remove="UI\Localization\Strings.de.axaml" />
    <AvaloniaResource Include="UI\Localization\Strings.de.axaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AvaloniaResource>
    <AvaloniaXaml Remove="UI\Localization\Strings.en.axaml" />
    <AvaloniaResource Include="UI\Localization\Strings.en.axaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AvaloniaResource>
    <AvaloniaXaml Remove="UI\Localization\Strings.ru.axaml" />
    <AvaloniaResource Include="UI\Localization\Strings.ru.axaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AvaloniaResource>
    <AvaloniaXaml Remove="UI\Localization\Strings.uk.axaml" />
    <AvaloniaResource Include="UI\Localization\Strings.uk.axaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AvaloniaResource>
    <AvaloniaXaml Remove="UI\Localization\Strings.tr.axaml" />
    <AvaloniaResource Include="UI\Localization\Strings.tr.axaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AvaloniaResource>
    <AvaloniaXaml Update="Windows\ContextMenuWindow.axaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </AvaloniaXaml>
    <AvaloniaXaml Update="Windows\LanguageWindow.axaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AvaloniaXaml>
    <AvaloniaXaml Update="Windows\UserAgreementWindow.axaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AvaloniaXaml>
  </ItemGroup>

  <ItemGroup>
    <!-- AI model: copy to output/publish so the app can load from AppContext.BaseDirectory\AiModel\... -->
    <!-- NOTE: absolute path as requested -->
    <None Include="E:\InsaitTextEditor\InsaitTextEditor\AiModel\gemma-3-1b-it-UD-Q2_K_XL.gguf">
      <Link>AiModel\gemma-3-1b-it-UD-Q2_K_XL.gguf</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>

    <None Update="Icons\AppIcon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Скрипт реєстрації файлових асоціацій для Windows -->

  <!-- Папки БД створюються автоматично при першому запуску додатка -->

  <Target Name="RemovePdbFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <!-- Remove any PDBs (managed or native) from publish output -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                            Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').ToLowerInvariant().EndsWith('.pdb'))" />
    </ItemGroup>
  </Target>

</Project>