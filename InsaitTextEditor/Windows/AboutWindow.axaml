<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InsaitTextEditor.Windows.AboutWindow"
        Title="{DynamicResource Key.AboutTitle}"
        Width="700"
        Height="200"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        CanResize="False"
        Background="#A9A9A9">
  <Window.Resources>
    <SolidColorBrush x:Key="AppGreenBrush" Color="#00C853"/>
    <SolidColorBrush x:Key="AppPurpleBrush" Color="#6A0DAD"/>
    <SolidColorBrush x:Key="AppGreyTopBrush" Color="#A9A9A9"/>
    <SolidColorBrush x:Key="AppDarkOrangeBrush" Color="#CC5500"/>

    <!-- Will be updated from code-behind to reflect workspace colors -->
    <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#A9A9A9"/>
    <SolidColorBrush x:Key="WorkspaceTextBrush" Color="#FF000000"/>

    <ControlTemplate x:Key="FlatButtonTemplate">
      <Border Background="{TemplateBinding Background}"
              CornerRadius="6"
              Padding="{TemplateBinding Padding}">
        <ContentPresenter
          Content="{TemplateBinding Content}"
          ContentTemplate="{TemplateBinding ContentTemplate}"
          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Border>
    </ControlTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource AppGreyTopBrush}">
      <DockPanel Margin="10,0" PointerPressed="TitleBar_PointerPressed">
        <Border DockPanel.Dock="Left"
                Background="{StaticResource AppDarkOrangeBrush}"
                CornerRadius="6"
                Height="36" MinWidth="150"
                VerticalAlignment="Center"
                Padding="8,3">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Image Source="avares://InsaitTextEditor/Icons/AppIcon.png" Width="20" Height="20" Stretch="Uniform"/>
            <TextBlock Text="{DynamicResource Key.AboutTitle}"
                       Foreground="{StaticResource AppGreenBrush}"
                       FontSize="13"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button Width="44" Height="40"
                  Background="#FFC466" BorderBrush="Transparent" BorderThickness="0"
                  Padding="6" Template="{StaticResource FlatButtonTemplate}"
                  Click="Minimize_Click">
            <Image Source="avares://InsaitTextEditor/Icons/MinButton.png" Stretch="Uniform"/>
          </Button>
          <Button Width="44" Height="40"
                  Background="#FFC466" BorderBrush="Transparent" BorderThickness="0"
                  Padding="6" Template="{StaticResource FlatButtonTemplate}"
                  Click="Close_Click">
            <Image Source="avares://InsaitTextEditor/Icons/CloseButton.png" Stretch="Uniform"/>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Content row (Row 1): must look like main workspace -->
    <Border Grid.Row="1"
            Background="{StaticResource WorkspaceBackgroundBrush}"
            PointerPressed="DragSurface_PointerPressed">
      <Grid Margin="12,8,12,12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">
        <Image Grid.Row="0" Grid.RowSpan="7" Grid.Column="0" Source="avares://InsaitTextEditor/Icons/AppIcon.png" Width="36" Height="36" Margin="0,2,10,0"/>

        <!-- Line 1: App name -->
        <TextBlock Grid.Column="1" Text="InsaitTextEditor" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource WorkspaceTextBrush}"/>
        <!-- Line 2: Version -->
        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{StaticResource WorkspaceTextBrush}">
          <Run Text="{DynamicResource Key.Version}"/>
          <Run x:Name="VersionNumberRun"/>
        </TextBlock>
        <!-- Line 3: Reserved/info line to satisfy 7-line layout (kept simple) -->
        <TextBlock Grid.Row="2" Grid.Column="1" Text="" Foreground="{StaticResource WorkspaceTextBrush}"/>
        <!-- Lines 4-7: About sentences, one per line -->
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource Key.AboutLine1}" Foreground="{StaticResource WorkspaceTextBrush}"
                   TextWrapping="Wrap" TextAlignment="Left" FontSize="12"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{DynamicResource Key.AboutLine2}" Foreground="{StaticResource WorkspaceTextBrush}"
                   TextWrapping="Wrap" TextAlignment="Left" FontSize="12"/>
        <TextBlock Grid.Row="5" Grid.Column="1" Text="{DynamicResource Key.AboutLine3}" Foreground="{StaticResource WorkspaceTextBrush}"
                   TextWrapping="Wrap" TextAlignment="Left" FontSize="12"/>
        <TextBlock Grid.Row="6" Grid.Column="1" Text="{DynamicResource Key.AboutLine4}" Foreground="{StaticResource WorkspaceTextBrush}"
                   TextWrapping="Wrap" TextAlignment="Left" FontSize="12"/>
      </Grid>

    </Border>
  </Grid>
</Window>