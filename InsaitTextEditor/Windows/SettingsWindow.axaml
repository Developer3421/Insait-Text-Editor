<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InsaitTextEditor.Windows.SettingsWindow"
        Title="{DynamicResource Key.Settings}"
        Width="600"
        Height="210"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        CanResize="False"
        Background="#6A0DAD">
  <Window.Resources>
    <SolidColorBrush x:Key="AppGreenBrush" Color="#00C853"/>
    <SolidColorBrush x:Key="AppPurpleBrush" Color="#6A0DAD"/>
    <SolidColorBrush x:Key="AppGreyTopBrush" Color="#A9A9A9"/>
    <SolidColorBrush x:Key="AppDarkOrangeBrush" Color="#CC5500"/>

    <ControlTemplate x:Key="FlatButtonTemplate">
      <Border Background="{TemplateBinding Background}"
              CornerRadius="6"
              Padding="{TemplateBinding Padding}">
        <ContentPresenter
          Content="{TemplateBinding Content}"
          ContentTemplate="{TemplateBinding ContentTemplate}"
          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Border>
    </ControlTemplate>
  </Window.Resources>

  <Grid >
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource AppGreyTopBrush}">
      <DockPanel Margin="10,0" PointerPressed="TitleBar_PointerPressed">
        <Border DockPanel.Dock="Left"
                Background="{StaticResource AppDarkOrangeBrush}"
                CornerRadius="6"
                Height="26" MinWidth="140"
                VerticalAlignment="Center"
                Padding="8,3">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Image Source="avares://InsaitTextEditor/Icons/AppIcon.png" Width="20" Height="20" Stretch="Uniform"/>
            <TextBlock Text="{DynamicResource Key.ApplicationSettings}"
                       Foreground="{StaticResource AppGreenBrush}"
                       FontSize="13"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button Width="36" Height="32"
                  Background="#FFC466" BorderBrush="Transparent" BorderThickness="0"
                  Padding="4" Template="{StaticResource FlatButtonTemplate}"
                  Click="Minimize_Click">
            <Image Source="avares://InsaitTextEditor/Icons/MinButton.png" Stretch="Uniform"/>
          </Button>
          <Button Width="36" Height="32"
                  Background="#FFC466" BorderBrush="Transparent" BorderThickness="0"
                  Padding="4" Template="{StaticResource FlatButtonTemplate}"
                  Click="Close_Click">
            <Image Source="avares://InsaitTextEditor/Icons/CloseButton.png" Stretch="Uniform"/>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Form -->
    <Border Grid.Row="1" PointerPressed="DragSurface_PointerPressed">
      <Grid Margin="12,8" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto" ColumnDefinitions="Auto,8,*,16,Auto,8,*,16,Auto,8,Auto">
        <!-- Left column: Workspace and text size -->
        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="#FFFFFF" Text="{DynamicResource Key.WorkspaceBackground}"/>
        <TextBox x:Name="PaperColorBox" Grid.Row="0" Grid.Column="2" MinWidth="120"/>

        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="#FFFFFF" Text="{DynamicResource Key.AltLineColor}"/>
        <TextBox x:Name="AltLineColorBox" Grid.Row="2" Grid.Column="2" MinWidth="120"/>

        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Foreground="#FFFFFF" Text="{DynamicResource Key.FontSize}"/>
        <TextBox x:Name="FontSizeBox" Grid.Row="4" Grid.Column="2" MinWidth="80"/>

        <!-- Right column: Tabs colors -->
        <TextBlock Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" Foreground="#FFFFFF" Text="{DynamicResource Key.TabsBackground}"/>
        <TextBox x:Name="TabsBackgroundBox" Grid.Row="0" Grid.Column="6" MinWidth="120"/>

        <TextBlock Grid.Row="2" Grid.Column="4" VerticalAlignment="Center" Foreground="#FFFFFF" Text="{DynamicResource Key.TabsTextColor}"/>
        <TextBox x:Name="TabsTextColorBox" Grid.Row="2" Grid.Column="6" MinWidth="120"/>

        <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="11" ColumnDefinitions="*,*">
          <Button Height="30" MinWidth="120"
                  Background="{StaticResource AppDarkOrangeBrush}"
                  Foreground="{StaticResource AppGreenBrush}"
                  BorderBrush="Transparent" BorderThickness="0"
                  Template="{StaticResource FlatButtonTemplate}"
                  HorizontalAlignment="Left"
                  Click="SaveDefaults_Click" Content="{DynamicResource Key.SaveAsDefault}"></Button>
          <Button Grid.Column="1" Height="30" MinWidth="110"
                  Background="{StaticResource AppDarkOrangeBrush}"
                  Foreground="{StaticResource AppGreenBrush}"
                  BorderBrush="Transparent" BorderThickness="0"
                  Template="{StaticResource FlatButtonTemplate}"
                  HorizontalAlignment="Right"
                  Click="ResetToDefaults_Click" Content="{DynamicResource Key.LoadDefaults}"></Button>
        </Grid>
      </Grid>
    </Border>

    <!-- Footer spacer area could be reused if needed -->
    <Border Grid.Row="2" Background="{StaticResource AppPurpleBrush}" Height="8"/>

  </Grid>
</Window>