<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InsaitTextEditor.Windows.LanguageWindow"
        Title="{DynamicResource Key.Language}"
        MinWidth="360"
        Height="160"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        CanResize="False"
        Background="#6A0DAD">
  <Window.Resources>
    <SolidColorBrush x:Key="AppGreenBrush" Color="#00C853"/>
    <SolidColorBrush x:Key="AppPurpleBrush" Color="#6A0DAD"/>
    <SolidColorBrush x:Key="AppGreyTopBrush" Color="#A9A9A9"/>
    <SolidColorBrush x:Key="AppDarkOrangeBrush" Color="#CC5500"/>

    <ControlTemplate x:Key="FlatButtonTemplate">
      <Border Background="{TemplateBinding Background}"
              CornerRadius="6"
              Padding="{TemplateBinding Padding}">
        <ContentPresenter
          Content="{TemplateBinding Content}"
          ContentTemplate="{TemplateBinding ContentTemplate}"
          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Border>
    </ControlTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource AppGreyTopBrush}">
      <DockPanel Margin="10,0" PointerPressed="TitleBar_PointerPressed">
        <Border DockPanel.Dock="Left"
                Background="{StaticResource AppDarkOrangeBrush}"
                CornerRadius="6"
                Height="36" MinWidth="160"
                VerticalAlignment="Center"
                Padding="8,3">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Image Source="avares://InsaitTextEditor/Icons/AppIcon.png" Width="20" Height="20" Stretch="Uniform"/>
            <TextBlock Text="{DynamicResource Key.Language}"
                       Foreground="{StaticResource AppGreenBrush}"
                       FontSize="13"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button Width="44" Height="40"
                  Background="#FFC466" BorderBrush="Transparent" BorderThickness="0"
                  Padding="6" Template="{StaticResource FlatButtonTemplate}"
                  Click="Minimize_Click">
            <Image Source="avares://InsaitTextEditor/Icons/MinButton.png" Stretch="Uniform"/>
          </Button>
          <Button Width="44" Height="40"
                  Background="#FFC466" BorderBrush="Transparent" BorderThickness="0"
                  Padding="6" Template="{StaticResource FlatButtonTemplate}"
                  Click="Close_Click">
            <Image Source="avares://InsaitTextEditor/Icons/CloseButton.png" Stretch="Uniform"/>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Content -->
    <Border Grid.Row="1" PointerPressed="DragSurface_PointerPressed">
      <Grid Margin="12,8,12,12" ColumnDefinitions="*,*,*,*,*" >
        <Button Grid.Column="0" Height="36" Margin="0,0,8,0"
                Background="{StaticResource AppDarkOrangeBrush}"
                Foreground="{StaticResource AppGreenBrush}"
                BorderBrush="Transparent" BorderThickness="0"
                Template="{StaticResource FlatButtonTemplate}"
                Click="German_Click"
                Content="{DynamicResource Key.German}"/>
        <Button Grid.Column="1" Height="36" Margin="4,0"
                Background="{StaticResource AppDarkOrangeBrush}"
                Foreground="{StaticResource AppGreenBrush}"
                BorderBrush="Transparent" BorderThickness="0"
                Template="{StaticResource FlatButtonTemplate}"
                Click="Russian_Click"
                Content="{DynamicResource Key.Russian}"/>
        <Button Grid.Column="2" Height="36" Margin="4,0"
                Background="{StaticResource AppDarkOrangeBrush}"
                Foreground="{StaticResource AppGreenBrush}"
                BorderBrush="Transparent" BorderThickness="0"
                Template="{StaticResource FlatButtonTemplate}"
                Click="Ukrainian_Click"
                Content="{DynamicResource Key.Ukrainian}"/>
        <Button Grid.Column="3" Height="36" Margin="4,0"
                Background="{StaticResource AppDarkOrangeBrush}"
                Foreground="{StaticResource AppGreenBrush}"
                BorderBrush="Transparent" BorderThickness="0"
                Template="{StaticResource FlatButtonTemplate}"
                Click="English_Click"
                Content="{DynamicResource Key.English}"/>
        <Button Grid.Column="4" Height="36" Margin="8,0,0,0"
                Background="{StaticResource AppDarkOrangeBrush}"
                Foreground="{StaticResource AppGreenBrush}"
                BorderBrush="Transparent" BorderThickness="0"
                Template="{StaticResource FlatButtonTemplate}"
                Click="Turkish_Click"
                Content="{DynamicResource Key.Turkish}"/>
      </Grid>
    </Border>
  </Grid>
</Window>