  <!-- File Menu titles -->
  <x:String x:Key="Key.FileMenu">Dosya Menüsü</x:String>

  <!-- About window -->
  <x:String x:Key="Key.AboutTitle">Uygulama Hakkında</x:String>
  <x:String x:Key="Key.Version">Sürüm</x:String>
  <x:String x:Key="Key.AboutLine1">InsaitTextEditor Windows için hızlı bir not defteridir.</x:String>
  <x:String x:Key="Key.AboutLine2">InsaitTextEditor, internet erişimi olmayan yerlerde bile yazmanıza yardımcı olan yerel bir yazma asistanı içerir.</x:String>
  <x:String x:Key="Key.AboutLine3">23 Ağustos 2025'te geliştirici Oleh Kurylo tarafından oluşturuldu.</x:String>
  <x:String x:Key="Key.AboutLine4">Tüm kullanıcı verileri yerel olarak saklanır.</x:String>

  <!-- Language names -->
  <x:String x:Key="Key.German">Deutsch</x:String>
