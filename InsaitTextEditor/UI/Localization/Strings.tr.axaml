  <x:String x:Key="Key.English">English</x:String>
  <x:String x:Key="Key.Turkish">Türkçe</x:String>

  <!-- Instruction Editor Window -->
  <x:String x:Key="Key.InstructionEditor">Özel Talimat Düzenleyici</x:String>
  <x:String x:Key="Key.CustomInstruction">Özel Talimat</x:String>
  <x:String x:Key="Key.InstructionPlaceholder">AI asistanı için özel talimatınızı girin...</x:String>
  <x:String x:Key="Key.PerformanceSettings">Performans Ayarları</x:String>
  <x:String x:Key="Key.ContextSize">Bağlam Boyutu (Giriş Belirteçleri):</x:String>
  <x:String x:Key="Key.MaxTokens">Maksimum Belirteç (Çıkış):</x:String>
  <x:String x:Key="Key.AILanguage">AI Model Dili:</x:String>
  <x:String x:Key="Key.AILangAuto">Otomatik (Arayüzden algıla)</x:String>
  <x:String x:Key="Key.InstructionNote">Not: Daha iyi AI anlayışı için İngilizce kullanın. Düşük değerler performansı artırır.</x:String>

  <!-- Chat Window -->
  <x:String x:Key="Key.TypeMessage">Mesajınızı buraya yazın...</x:String>
  <x:String x:Key="Key.Thinking">Düşünüyor...</x:String>
  <x:String x:Key="Key.CopyMessage">Kopyala</x:String>
  <x:String x:Key="Key.DeleteMessage">Sil</x:String>
  <x:String x:Key="Key.WelcomeMessage">Hoş geldiniz! Ben Insait Creative Assistant 🤖

Size şunlarda yardımcı olabilirim:
• Soruları yanıtlama
• Metin düzenleme
• İçerik oluşturma
• **Şiir oluşturma** (otomatik kaydedilir!)

Sadece sorunuzu yazın! (Göndermek için Ctrl+Enter)</x:String>
  
  <!-- Reasoning Mode and Global Memory -->
  <x:String x:Key="Key.ReasoningMode">🧠 Akıl Yürütme Modu</x:String>
  <x:String x:Key="Key.ReasoningModeDescription">AI karmaşık problemler için adım adım çözüm gösterecek</x:String>
  <x:String x:Key="Key.GlobalMemory">💾 Küresel Hafıza</x:String>
  <x:String x:Key="Key.GlobalMemoryDescription">AI daha iyi bağlam için oturumlar arası gerçekleri hatırlayacak</x:String>
  <x:String x:Key="Key.MemoryStats">Kaydedilen gerçekler: {0} | Son güncelleme: {1}</x:String>
  <x:String x:Key="Key.ReasoningStep">Adım {0}</x:String>
  <x:String x:Key="Key.FinalAnswer">Son Cevap</x:String>
  
  <!-- Reasoning Process Messages -->
  <x:String x:Key="Key.ReasoningGeneratingPlan">📝 Akıl yürütme planı oluşturuluyor...</x:String>
  <x:String x:Key="Key.ReasoningGeneratingPlanProgress">📝 Plan oluşturuluyor... ({0} token)</x:String>
  <x:String x:Key="Key.ReasoningPlanReady">✅ Plan hazır: {0} adım</x:String>
  <x:String x:Key="Key.ReasoningStepProgress">🔄 Adım {0}/{1}: {2}</x:String>
  <x:String x:Key="Key.ReasoningStepComplete">✅ Adım {0} tamamlandı</x:String>
  <x:String x:Key="Key.ReasoningGeneratingFinalAnswer">🎯 Son cevap oluşturuluyor...</x:String>
  <x:String x:Key="Key.ReasoningComplete">🎉 Akıl yürütme tamamlandı!</x:String>
  <x:String x:Key="Key.ReasoningPlanCancelled">❌ Plan oluşturma iptal edildi</x:String>
  <x:String x:Key="Key.ReasoningPlanFailed">❌ Plan oluşturulamadı</x:String>
</ResourceDictionary>
