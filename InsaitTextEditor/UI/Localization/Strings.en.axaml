  <!-- About window -->
  <x:String x:Key="Key.AboutTitle">About App</x:String>
  <x:String x:Key="Key.Version">Version</x:String>
  <x:String x:Key="Key.AboutLine1">InsaitTextEditor is a fast notepad for Windows.</x:String>
  <x:String x:Key="Key.AboutLine2">InsaitTextEditor includes a local writing assistant that helps you write even in places without Internet access.</x:String>
  <x:String x:Key="Key.AboutLine3">It was created by developer Oleh Kurylo on August 23, 2025.</x:String>
  <x:String x:Key="Key.AboutLine4">All user data is stored locally.</x:String>

  <!-- Language names -->
  <x:String x:Key="Key.German">Deutsch</x:String>
  <x:String x:Key="Key.Russian">Русский</x:String>
  <x:String x:Key="Key.Ukrainian">Українська</x:String>
  <x:String x:Key="Key.English">English</x:String>
  <x:String x:Key="Key.Turkish">Türkçe</x:String>

  <!-- Instruction Editor Window -->
  <x:String x:Key="Key.InstructionEditor">Custom Instruction Editor</x:String>
  <x:String x:Key="Key.CustomInstruction">Custom Instruction</x:String>
  <x:String x:Key="Key.InstructionPlaceholder">Enter your custom instruction for the AI assistant...</x:String>
  <x:String x:Key="Key.PerformanceSettings">Performance Settings</x:String>
  <x:String x:Key="Key.ContextSize">Context Size (Input Tokens):</x:String>
  <x:String x:Key="Key.MaxTokens">Max Tokens (Output):</x:String>
  <x:String x:Key="Key.AILanguage">AI Model Language:</x:String>
  <x:String x:Key="Key.AILangAuto">Auto (Detect from UI)</x:String>
  <x:String x:Key="Key.InstructionNote">Note: Use English for better AI understanding. Lower values improve performance.</x:String>

  <!-- Chat Window -->
  <x:String x:Key="Key.TypeMessage">Type your message here...</x:String>
  <x:String x:Key="Key.Thinking">Thinking...</x:String>
  <x:String x:Key="Key.CopyMessage">Copy</x:String>
  <x:String x:Key="Key.DeleteMessage">Delete</x:String>
  <x:String x:Key="Key.WelcomeMessage">Welcome! I'm Insait Creative Assistant 🤖

I can help you with:
• Answering questions
• Editing text
• Generating content
• **Creating poems** (automatically saved!)

Just type your question! (Ctrl+Enter to send)</x:String>
  
  <!-- Reasoning Mode and Global Memory -->
  <x:String x:Key="Key.ReasoningMode">🧠 Reasoning Mode</x:String>
  <x:String x:Key="Key.ReasoningModeDescription">AI will show step-by-step solution for complex problems</x:String>
  <x:String x:Key="Key.GlobalMemory">💾 Global Memory</x:String>
  <x:String x:Key="Key.GlobalMemoryDescription">AI will remember facts across sessions for better context</x:String>
  <x:String x:Key="Key.MemoryStats">Facts saved: {0} | Last update: {1}</x:String>
  <x:String x:Key="Key.ReasoningStep">Step {0}</x:String>
  <x:String x:Key="Key.FinalAnswer">Final Answer</x:String>
  
  <!-- Reasoning Process Messages -->
  <x:String x:Key="Key.ReasoningGeneratingPlan">📝 Generating reasoning plan...</x:String>
  <x:String x:Key="Key.ReasoningGeneratingPlanProgress">📝 Generating plan... ({0} tokens)</x:String>
  <x:String x:Key="Key.ReasoningPlanReady">✅ Plan ready: {0} steps</x:String>
  <x:String x:Key="Key.ReasoningStepProgress">🔄 Step {0}/{1}: {2}</x:String>
  <x:String x:Key="Key.ReasoningStepComplete">✅ Step {0} complete</x:String>
  <x:String x:Key="Key.ReasoningGeneratingFinalAnswer">🎯 Generating final answer...</x:String>
  <x:String x:Key="Key.ReasoningComplete">🎉 Reasoning complete!</x:String>
  <x:String x:Key="Key.ReasoningPlanCancelled">❌ Plan generation cancelled</x:String>
  <x:String x:Key="Key.ReasoningPlanFailed">❌ Failed to generate plan</x:String>

  <!-- Complaint Window -->
  <x:String x:Key="Key.ComplaintTitle">Complaint</x:String>
  <x:String x:Key="Key.ComplaintHeader">Complaint</x:String>
  <x:String x:Key="Key.ComplaintAiTitle">Complaint about AI answer</x:String>
  <x:String x:Key="Key.ComplaintSendInstruction">Please send to vetalebrowser01@gmail.com</x:String>
  <x:String x:Key="Key.ComplaintAiAnswerLabel">AI answer (context):</x:String>
  <x:String x:Key="Key.ComplaintPlaceholder">Please describe your complaint...</x:String>
  <x:String x:Key="Key.ComplaintSaveToFile">Save to file</x:String>

  <!-- User agreement / GDPR -->
  <x:String x:Key="Key.UserAgreement">User Agreement</x:String>
  <x:String x:Key="Key.UserAgreementTitle">User Agreement (GDPR)</x:String>
  <x:String x:Key="Key.UserAgreementHeader">User agreement / GDPR</x:String>

  <x:String x:Key="Key.UserAgreementSectionTitle">Privacy &amp; local data storage</x:String>
  <x:String x:Key="Key.UserAgreementOffline">InsaitTextEditor works fully offline. The application does not use the Internet, does not send telemetry, does not upload your content to any cloud services, and does not connect to external servers.</x:String>

  <x:String x:Key="Key.UserAgreementWhatTitle">What data is stored (locally)</x:String>
  <x:String x:Key="Key.UserAgreementWhatItem1">• App settings (theme colors, font size, language).</x:String>
  <x:String x:Key="Key.UserAgreementWhatItem2">• Chat history (your messages and assistant replies), including timestamps.</x:String>
  <x:String x:Key="Key.UserAgreementWhatItem3">• Reasoning/memory/documents features may store derived notes or extracted memory snippets to improve local experience.</x:String>

  <x:String x:Key="Key.UserAgreementWhereTitle">Where it is stored</x:String>
  <x:String x:Key="Key.UserAgreementWhereIntro">Data is saved in local LiteDB files next to the app (inside the app folder). Depending on the feature, databases are stored under:</x:String>
  <x:String x:Key="Key.UserAgreementWhereItem1">• Database\settings_v2.litedb (basic settings)</x:String>
  <x:String x:Key="Key.UserAgreementWhereItem2">• Data\Encrypted\... (encrypted feature databases: ChatHistory, Memory, Reasoning, Documents, Settings)</x:String>
  <x:String x:Key="Key.UserAgreementWhereItem3">• Data\Keys\master.key (local encryption key used to protect encrypted databases)</x:String>
  <x:String x:Key="Key.UserAgreementDeleteNote">You can delete your local data at any time by removing these folders/files. If you delete the encryption key, encrypted databases can’t be decrypted anymore.</x:String>

  <x:String x:Key="Key.UserAgreementRightsTitle">Your rights</x:String>
  <x:String x:Key="Key.UserAgreementRightsText">Because everything stays on this device, you control your data directly: access, modification, and deletion. There’s no remote copy kept by the app.</x:String>

  <x:String x:Key="Key.UserAgreementConsent">I have read and accept the User Agreement and local data storage policy</x:String>
  <x:String x:Key="Key.UserAgreementMustAccept">You must accept to continue.</x:String>
  <x:String x:Key="Key.Accept">Accept</x:String>
  <x:String x:Key="Key.Decline">Decline</x:String>
</ResourceDictionary>