  <x:String x:Key="Key.Copy">Копировать</x:String>
  <x:String x:Key="Key.Paste">Вставить</x:String>
  <x:String x:Key="Key.SelectAll">Выделить всё</x:String>
  <x:String x:Key="Key.Undo">Отменить</x:String>
  <x:String x:Key="Key.Redo">Повторить</x:String>
  <x:String x:Key="Key.Rewrite">Переформулировать</x:String>
  <x:String x:Key="Key.Summarize">Суммировать</x:String>
