  <!-- About window -->
  <x:String x:Key="Key.AboutTitle">О приложении</x:String>
  <x:String x:Key="Key.Version">Версия</x:String>
  <x:String x:Key="Key.AboutLine1">InsaitTextEditor — это быстрый блокнот для Windows.</x:String>
  <x:String x:Key="Key.AboutLine2">InsaitTextEditor включает локального помощника для письма, который помогает даже без доступа к Интернету.</x:String>
  <x:String x:Key="Key.AboutLine3">Создан разработчиком Олегом Курило 23 августа 2025 года.</x:String>
  <x:String x:Key="Key.AboutLine4">Все данные пользователя хранятся локально.</x:String>

