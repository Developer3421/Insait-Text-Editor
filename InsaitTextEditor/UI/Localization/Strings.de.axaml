<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Common -->
  <x:String x:Key="Key.Menu">Menü</x:String>
  <x:String x:Key="Key.File">Datei</x:String>
  <x:String x:Key="Key.View">Ansicht</x:String>
  <x:String x:Key="Key.Settings">Einstellungen</x:String>
  <x:String x:Key="Key.AboutApp">Über die App</x:String>
  <x:String x:Key="Key.Language">Sprache</x:String>
  <x:String x:Key="Key.SelectLanguage">Sprache auswählen</x:String>
  <x:String x:Key="Key.Open">Öffnen...</x:String>
