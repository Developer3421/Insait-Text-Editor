  <!-- About window -->
  <x:String x:Key="Key.AboutTitle">Über die App</x:String>
  <x:String x:Key="Key.Version">Version</x:String>
  <x:String x:Key="Key.AboutLine1">InsaitTextEditor ist ein schneller Notizblock für Windows.</x:String>
  <x:String x:Key="Key.AboutLine2">InsaitTextEditor enthält einen lokalen Schreibassistenten, der auch ohne Internetzugang hilft.</x:String>
  <x:String x:Key="Key.AboutLine3">Er wurde vom Entwickler Oleh Kurylo am 23. August 2025 erstellt.</x:String>
  <x:String x:Key="Key.AboutLine4">Alle Benutzerdaten werden lokal gespeichert.</x:String>

  <!-- Language names -->
  <x:String x:Key="Key.German">Deutsch</x:String>
