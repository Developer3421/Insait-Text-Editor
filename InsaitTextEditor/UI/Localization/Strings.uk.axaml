  <!-- About window -->
  <x:String x:Key="Key.AboutTitle">Про застосунок</x:String>
  <x:String x:Key="Key.Version">Версія</x:String>
  <x:String x:Key="Key.AboutLine1">InsaitTextEditor — це швидкий блокнот для Windows.</x:String>
  <x:String x:Key="Key.AboutLine2">InsaitTextEditor має локального асистента для письма, який допомагає навіть без доступу до Інтернету.</x:String>
  <x:String x:Key="Key.AboutLine3">Створено розробником Олегом Курилом 23 серпня 2025 року.</x:String>
  <x:String x:Key="Key.AboutLine4">Усі дані користувача зберігаються локально.</x:String>

  <!-- Language names -->
  <x:String x:Key="Key.German">Deutsch</x:String>
