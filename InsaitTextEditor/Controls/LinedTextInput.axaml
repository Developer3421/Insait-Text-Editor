<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sk="clr-namespace:InsaitTextEditor.Scripts.SkiaSharp"
             x:Class="InsaitTextEditor.Controls.LinedTextInput"
             x:Name="Root">
  <UserControl.Styles>
    <!-- Thin vertical scrollbar similar to Notepad -->
    <Style Selector="ScrollViewer.ThinScrollBar">
      <Setter Property="AllowAutoHide" Value="False"/>
    </Style>
    <Style Selector="ScrollViewer.ThinScrollBar /template/ ScrollBar:vertical">
      <Setter Property="Width" Value="16"/>
      <Setter Property="MinWidth" Value="16"/>
    </Style>
    <Style Selector="ScrollViewer.ThinScrollBar /template/ ScrollBar:vertical /template/ RepeatButton">
      <Setter Property="Width" Value="16"/>
    </Style>
    <Style Selector="ScrollViewer.ThinScrollBar /template/ ScrollBar:vertical /template/ Border#TrackBorder">
      <Setter Property="Background" Value="#F0F0F0"/>
      <Setter Property="Width" Value="16"/>
    </Style>
    <Style Selector="ScrollViewer.ThinScrollBar /template/ ScrollBar:vertical /template/ Thumb">
      <Setter Property="Background" Value="#C0C0C0"/>
      <Setter Property="Width" Value="16"/>
    </Style>
    <Style Selector="ScrollViewer.ThinScrollBar /template/ ScrollBar:vertical /template/ Thumb:pointerover">
      <Setter Property="Background" Value="#A0A0A0"/>
    </Style>
    <Style Selector="ScrollViewer.ThinScrollBar /template/ ScrollBar:vertical /template/ Thumb:pressed">
      <Setter Property="Background" Value="#808080"/>
    </Style>
  </UserControl.Styles>
  <ScrollViewer x:Name="EditorScroll"
                Classes="ThinScrollBar"
                HorizontalScrollBarVisibility="Visible"
                VerticalScrollBarVisibility="Visible"
                MinWidth="200"
                Padding="0,0,16,0">

    <!-- Container that actually grows in height => ScrollViewer shows scrollbar -->
    <Grid x:Name="LayoutRoot" Background="Transparent" ClipToBounds="True">
      <sk:RuledBackground x:Name="Bg"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          IsHitTestVisible="False"
          PaperBrush="{Binding PaperBrush, ElementName=Root}"
          LineSpacing="{Binding LineSpacing, ElementName=Root}"
          LineThickness="{Binding LineThickness, ElementName=Root}"
          LineBrush="{Binding LineBrush, ElementName=Root}"
          LeftMargin="{Binding LeftMargin, ElementName=Root}"
          RightMargin="{Binding RightMargin, ElementName=Root}"
          TopMargin="{Binding TopMargin, ElementName=Root}"
          BottomMargin="{Binding BottomMargin, ElementName=Root}"
          FirstLineOffset="{Binding FirstLineOffset, ElementName=Root}"
          DrawVerticalMarginLine="{Binding DrawVerticalMarginLine, ElementName=Root}"
          VerticalMarginLineBrush="{Binding VerticalMarginLineBrush, ElementName=Root}"
          BackgroundMode="{Binding BackgroundMode, ElementName=Root}"/>

      <sk:RichTextOverlay x:Name="Overlay"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Margin="{Binding TextPadding, ElementName=Root}"
                          Text="{Binding Text, ElementName=Root, Mode=TwoWay}"
                          FontSize="{Binding EditorFontSize, ElementName=Root}"
                          TextBrush="{Binding TextBrush, ElementName=Root}"
                          LineSpacing="{Binding LineSpacing, ElementName=Root}"
                          FirstLineOffset="{Binding FirstLineOffset, ElementName=Root}"
                          TopMargin="{Binding TopMargin, ElementName=Root}"
                          Focusable="True"
                          IsHitTestVisible="True"
                          DefaultBold="{Binding BoldDefault, ElementName=Root}"
                          DefaultItalic="{Binding ItalicDefault, ElementName=Root}"
                          SelectionStart="{Binding SelectionStart, ElementName=Root}"
                          SelectionEnd="{Binding SelectionEnd, ElementName=Root}"
                          CaretBrush="#B400FF"
                          CaretWidth="2.5"/>
    </Grid>
  </ScrollViewer>
</UserControl>